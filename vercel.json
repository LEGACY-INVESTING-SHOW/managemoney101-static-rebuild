{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/fbmasterclass",
      "destination": "/taxtraining",
      "permanent": true
    },
    {
      "source": "/masterclassconfirmation",
      "destination": "/registered",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/taxtraining",
      "destination": "/fbmasterclass"
    },
    {
      "source": "/registered",
      "destination": "/masterclassconfirmation"
    }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/masterclass-reminder.ics",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
